# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# media
# Source vault: ~2.3GB of camera/export masters. Local-only input for the
# transcode step — never committed, never served.
/public/real/
# Web renditions + posters (~690MB) are NOT in git — they're deployed to a
# separate media host and referenced absolutely via NEXT_PUBLIC_MEDIA_BASE_URL.
# src/data/media.json IS committed, so the app builds without the binaries.
/public/media/*
# ...except the waveform peaks. VoiceSamples fetch()es these, and a
# cross-origin fetch would need CORS headers the media host doesn't send, so
# they have to be same-origin. All nine total 41KB.
!/public/media/audio/
/public/media/audio/*
!/public/media/audio/*.peaks.json

# Payload CMS scratch from an earlier experiment on another branch. Not used
# by this branch — ignored so it can't be committed by accident.
/payload.db*
/payload-media/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify: derived knowledge graph of src/. Regenerate with `/graphify src`.
graphify-out/
